#!/bin/bash
HERE="$(dirname "$(readlink -f "${0}")")"
export PREFIX=${HERE}/usr
# export LD_LIBRARY_PATH=${HERE}/usr/lib${LD_LIBRARY_PATH:+':'}$LD_LIBRARY_PATH
export PYTHONHOME=${HERE}/usr
export PATH_TO_FREECAD_LIBDIR=${HERE}/usr/lib
# export QT_QPA_PLATFORM_PLUGIN_PATH=${HERE}/usr/plugins
# export QT_XKB_CONFIG_ROOT=${HERE}/usr/lib
export FONTCONFIG_FILE=/etc/fonts/fonts.conf
export FONTCONFIG_PATH=/etc/fonts

# Fontconfig do sistema no lugar do embutido: o embutido lê a configuração e o cache de fontes do sistema e,
# em distribuições atualizadas (Linux Mint 22, Kubuntu 24.04...), o Usinix fechava ao abrir com falha de
# segmentação em libfontconfig (FcCharSetHasChar). Mesmo defeito do AppImage do FreeCAD (issues 32926 e
# 33377); o contorno conferido lá é carregar a biblioteca do sistema. USINIX_FONTCONFIG_EMBUTIDO=1 desliga.
if [ "${USINIX_FONTCONFIG_EMBUTIDO:-0}" != 1 ]; then
    for fc in /usr/lib/x86_64-linux-gnu/libfontconfig.so.1 /usr/lib64/libfontconfig.so.1 \
              /usr/lib/libfontconfig.so.1 /lib/x86_64-linux-gnu/libfontconfig.so.1; do
        if [ -e "$fc" ]; then
            export LD_PRELOAD="$fc${LD_PRELOAD:+:$LD_PRELOAD}"
            break
        fi
    done
fi

# Fix: Use X to run on Wayland
export QT_QPA_PLATFORM=xcb

# Show packages info if DEBUG env variable is set
if [ "$DEBUG" = 1 ]; then
    cat ${HERE}/packages.txt
fi

# SSL
# https://forum.freecad.org/viewtopic.php?f=4&t=34873&start=20#p327416
export SSL_CERT_FILE=$PREFIX/ssl/cacert.pem
# https://github.com/FreeCAD/FreeCAD-AppImage/pull/20
export GIT_SSL_CAINFO=$HERE/usr/ssl/cacert.pem

# Support for launching other applications (from /usr/bin)
# https://github.com/FreeCAD/FreeCAD-AppImage/issues/30
if [ ! -z "$1" ] && [ -e "$HERE/usr/bin/$1" ] ; then
    MAIN="$HERE/usr/bin/$1" ; shift
else
    MAIN="$HERE/usr/bin/usinix"
fi

# Usinix (antes Prumo 3D): na primeira abertura, as configurações do Prumo viram a base das do Usinix.
# O complemento antigo na pasta do usuário (Mod/Prumo3D) não vem: passaria por cima do programa novo.
for base in "${XDG_DATA_HOME:-$HOME/.local/share}" "${XDG_CONFIG_HOME:-$HOME/.config}"; do
    if [ -d "$base/Prumo3D" ] && [ ! -e "$base/Usinix" ]; then
        cp -a "$base/Prumo3D" "$base/Usinix" 2>/dev/null && rm -rf "$base/Usinix"/*/Mod/Prumo3D
    fi
done

"${MAIN}" "$@"
